{
    "name": "spryker/falcon-ui",
    "type": "library",
    "description": "FalconUi module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker/composable-backoffice-ui": "^0.1.0",
        "spryker/doctrine-inflector": "^1.0.0",
        "spryker/kernel": "^3.30.0",
        "spryker/oauth": "^2.13.0",
        "spryker/session": "^4.0.0",
        "spryker/symfony": "^3.19.0",
        "spryker/transfer": "^3.27.0",
        "spryker/twig-extension": "^1.0.0"
    },
    "require-dev": {
        "spryker/code-sniffer": "*",
        "spryker/container": "*",
        "spryker/twig": "*"
    },
    "suggest": {
        "spryker/container": "ADD SUGGEST DESCRIPTION",
        "spryker/twig": "ADD SUGGEST DESCRIPTION"
    },
    "autoload": {
        "psr-4": {
            "Spryker\\": "src/Spryker/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
