{
    "compilerOptions": {
        "outDir": "./out-tsc/app",
        "types": [],
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "useDefineForClassFields": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "sourceMap": true,
        "noImplicitAny": false,
        "declaration": false,
        "noEmitHelpers": true,
        "importHelpers": true,
        "skipDefaultLibCheck": true,
        "removeComments": true,
        "lib": ["dom", "esnext"]
    },
    "files": ["./main.ts"],
    "include": ["**/*.ts"],
    "exclude": ["**/*.spec.ts"]
}
