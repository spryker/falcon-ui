{
    "extends": "../../../../../../../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./out-tsc/app",
        "types": [],
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "useDefineForClassFields": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true
    },
    "files": ["./main.ts"],
    "include": ["**/*.ts"],
    "exclude": ["**/*.spec.ts"]
}
